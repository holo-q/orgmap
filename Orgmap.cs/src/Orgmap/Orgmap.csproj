<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The C# face of the orgmap workgroup-identity protocol (the Rust `orgmap`
    crate in repo-agent/orgmap). Layout mirrors VTR.cs / Ratatui.cs: self-
    contained (declares its own TFM/lang/nullable, no Directory.Build.props),
    framework-only deps, AOT-clean.

    The interop layer (src/Orgmap/Interop/Native.cs) is GENERATED by rustbind
    from ../orgmap-ffi/bindings.json — never hand-edit it; regenerate with the
    rustbind gen-cs verb against ../../rustbind.toml. The hand-written ergonomic
    layer (Orgmap.cs, WorkgroupIdentity.cs, SectionRank.cs, the JSON DTOs) sits
    on top.

    Consumed cross-repo by babel (repo-os3/babel) via ProjectReference, replacing
    its three hand-rolled orgmap reimplementations. Runtime resolution of
    liborgmap_ffi.so is handled by the generated resolver (ORGMAP_FFI_DIR /
    ORGMAP_FFI_PATH env overrides, or the dev target/{debug,release} walk);
    DllImports compile without the .so present, so babel builds need no native
    artifact.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required for the &amp;ansi out-param pointer in Orgmap.ColorTextToAnsi256. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Orgmap</AssemblyName>
    <RootNamespace>Orgmap</RootNamespace>
    <Description>C# bindings for the orgmap workgroup-identity protocol (generated via rustbind).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <Deterministic>true</Deterministic>
    <!-- Consumed by NativeAOT apps (babel, bob). Run trim/AOT analyzers here, at
         the leaf, so any reflection/trim-unsafe pattern surfaces at the binding
         instead of as a warning storm in each consumer. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
